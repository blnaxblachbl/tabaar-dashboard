    "home": {
      "tabaar-title": "Tabaar — Servicio de gestión de productos de código abierto",
      "description": "Tabaar es un servicio de gestión de catálogos e información de productos (PIM) moderno, de alto rendimiento y de código abierto, diseñado para aplicaciones de comercio electrónico y multicanal de alto rendimiento. Diseñado desde cero para soportar sistemas distribuidos modernos, Tabaar expone simultáneamente interfaces REST, GraphQL y gRPC impulsadas por una arquitectura de datos híbrida PostgreSQL + Elasticsearch y almacenamiento multimedia compatible con S3.",
      "explain": "En el comercio electrónico contemporáneo y las arquitecturas de microservicios, diferentes clientes requieren distintos paradigmas de comunicación: las aplicaciones móviles demandan puntos de conexión ligeros REST/GraphQL, los paneles web necesitan consultas GraphQL flexibles y los microservicios internos requieren RPCs gRPC de alta velocidad y baja latencia. Tabaar unifica la gestión del catálogo de productos en un motor único y cohesivo. En lugar de obligar a los equipos a elegir un estilo de API o mantener frágiles capas de adaptadores, Tabaar ofrece los tres protocolos de forma concurrente desde un núcleo único, respaldado por motores de almacenamiento dedicados y optimizados tanto para la integridad transaccional como para búsquedas a escala en menos de un milisegundo.",
      "docs": {
        "title": "Documentación de la API",
        "docs": "Docs",
        "rest": {
          "description": "La API REST incluye puntos de conexión para usuarios, imágenes de productos y claves API. También para la carga de imágenes y archivos. Admite autorización con token Bearer y acceso con clave API."
        },
        "graphql": {
          "description": "La API GraphQL incluye consultas y mutaciones de usuarios, productos y claves API. Admite autorización con token Bearer."
        },
        "grpc": {
          "description": "La API gRPC incluye servicios de usuarios, productos y claves API. Admite acceso con clave API."
        }
      }
    },
