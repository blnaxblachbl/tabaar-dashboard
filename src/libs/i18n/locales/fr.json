    "home": {
      "tabaar-title": "Tabaar — Service de gestion de produits open-source",
      "description": "Tabaar est un service moderne, performant et open-source de gestion des informations produits et des catalogues (PIM), conçu pour les applications e-commerce à haut débit et multicanal. Conçu dès le départ pour prendre en charge les systèmes distribués modernes, Tabaar expose simultanément des interfaces REST, GraphQL et gRPC alimentées par une architecture de données hybride PostgreSQL + Elasticsearch et un stockage multimédia compatible S3.",
      "explain": "Dans l'e-commerce contemporain et les architectures de microservices, différents clients nécessitent différents paradigmes de communication : les applications mobiles ont besoin de points de terminaison REST/GraphQL légers, les tableaux de bord Web nécessitent des requêtes GraphQL flexibles, et les microservices internes requièrent des RPC gRPC rapides et à faible latence. Tabaar unifie la gestion du catalogue de produits en un moteur unique et cohérent. Au lieu d'obliger les équipes à choisir un style d'API ou à maintenir des couches d'adaptation fragiles, Tabaar fournit simultanément les trois protocoles à partir d'un noyau unique, soutenu par des moteurs de stockage dédiés optimisés à la fois pour l'intégrité transactionnelle et pour la recherche à grande échelle en moins d'une milliseconde.",
      "docs": {
        "title": "Documentation de l'API",
        "docs": "Docs",
        "rest": {
          "description": "L'API REST comprend les points de terminaison pour les utilisateurs, les images de produits et les clés API, ainsi que le téléversement d'images et de fichiers. Prise en charge de l'autorisation par jeton Bearer et de l'accès par clé API."
        },
        "graphql": {
          "description": "L'API GraphQL comprend les requêtes et mutations pour les utilisateurs, les produits et les clés API. Prise en charge de l'autorisation par jeton Bearer."
        },
        "grpc": {
          "description": "L'API gRPC comprend les services pour les utilisateurs, les produits et les clés API. Prise en charge de l'accès par clé API."
        }
      }
    },
