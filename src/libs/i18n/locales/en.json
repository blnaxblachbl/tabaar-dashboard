        "omnichannel": "Omnichannel E-Commerce",
        "omnichannel-description": "Omnichannel E-Commerce Centralize product catalog, variants, pricing, and assets across web, mobile, in-store POS, and partner marketplaces.",
        "microservices": "Microservices Catalog Backbone",
        "microservices-description": "Serve internal ordering and inventory services over gRPC while exposing GraphQL to client applications.",
        "search": "High-Faceted Search Catalogs",
        "search-description": "High-Faceted Search Catalogs Deliver fast, complex attribute filtering (e.g., brand, price ranges, technical specs, categories) powered by Elasticsearch.",
        "dam": "Digital Asset Management (DAM)",
        "dam-description": "Digital Asset Management (DAM) Store and link high-resolution product photography and assets reliably via S3-compatible storage."
