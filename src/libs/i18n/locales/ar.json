    "home": {
      "tabaar-title": "Tabaar — خدمة إدارة المنتجات مفتوحة المصدر",
      "description": "Tabaar هي خدمة حديثة وعالية الأداء ومفتوحة المصدر لإدارة معلومات وكتالوجات المنتجات (PIM)، مصممة لخدمة تطبيقات التجارة الإلكترونية ذات الإنتاجية العالية والتطبيقات متعددة القنوات. تم بناء Tabaar من الأساس لدعم الأنظمة الموزعة الحديثة، حيث تتيح بالتزامن واجهات REST و GraphQL و gRPC المدعومة ببنية بيانات هجينة تجمع بين PostgreSQL و Elasticsearch، بالإضافة إلى تخزين وسائط متوافق مع S3.",
      "explain": "في التجارة الإلكترونية المعاصرة وبنى الخدمات المصغرة، تتطلب التطبيقات المختلفة نماذج تواصل متباينة: تحتاج تطبيقات الهاتف المحمول إلى نقاط نهاية REST/GraphQL خفيفة، وتتطلب لوحات التحكم عبر الويب استعلامات GraphQL مرنة، في حين تحتاج الخدمات المصغرة الداخلية إلى استدعاءات gRPC RPC سريعة ومنخفضة التأخير. يوحّد Tabaar إدارة كتالوج المنتجات في محرك واحد متماسك. بدلاً من إجبار الفرق على اختيار نمط API واحد أو صيانة طبقات مهايئة هشة، يقدّم Tabaar البروتوكولات الثلاثة في آنٍ واحد من نواة واحدة، مدعومة بمحركات تخزين مخصصة ومحسّنة لكلٍ من السلامة المعاملاتية والبحث في أجزاء من الميلي ثانية على نطاق واسع.",
      "docs": {
        "title": "توثيق واجهة برمجة التطبيقات (API)",
        "docs": "التوثيق",
        "rest": {
          "description": "تتضمن واجهة REST API نقاط نهاية للمستخدمين وصور المنتجات ومفاتيح API، بالإضافة إلى رفع الصور والملفات. تدعم مصادقة Bearer token والوصول عبر مفتاح API."
        },
        "graphql": {
          "description": "تتضمن واجهة GraphQL API استعلامات وعمليات تعديل للمستخدمين والمنتجات ومفاتيح API. تدعم مصادقة Bearer token."
        },
        "grpc": {
          "description": "تتضمن واجهة gRPC API خدمات المستخدمين والمنتجات ومفاتيح API. تدعم الوصول عبر مفتاح API."
        }
      }
